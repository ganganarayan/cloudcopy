# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Public origin for OAuth redirects (prod: your Railway domain)
# PUBLIC_URL=https://cloudcopy.up.railway.app
LOG_LEVEL=info

# ── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://cloudcopy:cloudcopy@localhost:5432/cloudcopy
# REDIS_URL=redis://localhost:6379

# ── Secrets ──────────────────────────────────────────────────────────────────
# 32 bytes base64 — generate with: openssl rand -base64 32
CREDENTIALS_KEY=
# Min 32 chars — session cookie encryption (required from Phase 2)
# SESSION_SECRET=

# ── Google OAuth (Phase 2) ───────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Engine tunables ──────────────────────────────────────────────────────────
ENGINE_MAX_FILES=4
ENGINE_CHUNKS_PER_FILE=8
ENGINE_CHUNK_SIZE=8388608
ENGINE_MEMORY_BUDGET_MB=384
